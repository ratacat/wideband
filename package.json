{
  "name": "wideband",
  "version": "0.2.0",
  "description": "Fan-out search across agentic search providers, merged into deduplicated sources with provenance and cost telemetry",
  "keywords": [
    "ai search api",
    "search api for ai agents",
    "agentic search",
    "agent web search",
    "web search for llm",
    "llm search api",
    "multi provider search",
    "search api aggregator",
    "metasearch",
    "search deduplication",
    "rag web search",
    "llm grounding",
    "deep research",
    "web search",
    "exa",
    "tavily",
    "brave search"
  ],
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./google-search": {
      "types": "./dist/google-search.d.mts",
      "default": "./dist/google-search.js"
    }
  },
  "bin": {
    "wideband": "dist/cli/main.js",
    "wideband-mcp": "dist/mcp/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratacat/wideband.git"
  },
  "scripts": {
    "test": "bun test",
    "cli": "bun src/cli/main.ts",
    "typecheck": "bunx tsc --noEmit",
    "build": "rm -rf dist && bun build src/index.ts src/cli/main.ts src/mcp/main.ts src/google-search.mjs --outdir dist --target bun --packages external && bunx tsc -p tsconfig.build.json && cp src/google-search.d.mts dist/google-search.d.mts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@ratacat/proxies": "git+ssh://git@github.com/ratacat/proxies.git"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
